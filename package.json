{
  "name": "drift-ui",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bun run registry:build && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json}\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.base-ui.json",
    "registry:build": "shadcn build && bun scripts/build-base-ui-registry.ts && shadcn build registry.base.json --output public/r/base",
    "test": "bun run registry:build && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "emojibase-data": "^18.0.0",
    "lenis": "^1.3.27",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^0.511.0",
    "motion": "^14.7.1",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.2",
    "react": "19.2.4",
    "react-day-picker": "9",
    "react-dom": "19.2.4",
    "shiki": "^4.5.0",
    "simple-icons": "^16.36.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^30.1.3",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.9.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
